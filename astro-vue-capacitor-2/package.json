{
  "name": "astro-vue-capacitor-2",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:mobile": "MOBILE=1 astro dev",
    "dev:lan": "LAN=1 astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:run": "astro build && cap run android",
    "cap:live": "CAP_LIVE=1 cap run android",
    "apk:debug": "astro build && cap sync android && ./android/gradlew -p android assembleDebug && echo 'APK -> android/app/build/outputs/apk/debug/app-debug.apk'",
    "apk:release": "astro build && cap sync android && ./android/gradlew -p android assembleRelease && echo 'APK -> android/app/build/outputs/apk/release/'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "astro check && oxlint"
  },
  "dependencies": {
    "@astrojs/vue": "^7.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@nanostores/vue": "^1.1.0",
    "astro": "^7.1.3",
    "idb": "^8.0.3",
    "nanostores": "^1.4.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@iconify-json/lucide": "^1.2.119",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.1.10"
  }
}
