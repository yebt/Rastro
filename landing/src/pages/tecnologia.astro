---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, GITHUB_URL } from '../consts';
import { STRINGS } from '../i18n';

const t = (k: string): string => STRINGS[k]?.es ?? k;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${STRINGS['tech.title1'].es} ${STRINGS['tech.title2'].es}`} description={STRINGS['tech.intro'].es} />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<div class="terrain" aria-hidden="true">
			<svg viewBox="0 0 1200 1600" preserveAspectRatio="xMidYMid slice">
				<g class="contours">
					<path d="M-100 300 C 200 220 420 380 640 300 S 1080 200 1320 320"></path>
					<path d="M-100 560 C 240 470 470 640 700 560 S 1100 460 1320 590"></path>
					<path d="M-100 900 C 300 790 540 980 800 900 S 1140 800 1320 940"></path>
					<path d="M-100 1320 C 340 1200 600 1400 880 1320 S 1180 1220 1320 1380"></path>
				</g>
			</svg>
		</div>

		<header class="nav">
			<div class="wrap nav-in">
				<a class="brand" href="/" aria-label="Rastro">
					<svg class="glyph" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
						<rect width="32" height="32" rx="7" fill="#0a0c0d" stroke="#232a2d"></rect>
						<path d="M10 27 L10 11 C10 6.5 21 6 21 12.5 C21 17 13.5 17 11 16.5 C15.5 17.5 18.5 23 22.5 27" fill="none" stroke="#4ce08c" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
						<circle cx="10" cy="27" r="2.6" fill="#eef1ee"></circle>
						<circle cx="22.5" cy="27" r="2.6" fill="none" stroke="#4ce08c" stroke-width="2"></circle>
					</svg>
					<span class="brand-name">Rastro</span>
				</a>
				<div class="nav-right">
					<a class="backlink" href="/" data-i18n="tech.back">{t('tech.back')}</a>
					<button id="lang" class="lang" type="button" aria-label="English / Español" data-i18n="cta.lang">{t('cta.lang')}</button>
				</div>
			</div>
		</header>

		<main>
			<section class="thero">
				<div class="wrap" data-reveal>
					<h1 class="hero-title">
						<span data-i18n="tech.title1">{t('tech.title1')}</span>{' '}<em data-i18n="tech.title2">{t('tech.title2')}</em>
					</h1>
					<p class="lead big" data-i18n="tech.intro">{t('tech.intro')}</p>
				</div>
			</section>

			<section class="band">
				<div class="wrap arch">
					<div class="arch-copy" data-reveal>
						<h2 data-i18n="tech.arch.title">{t('tech.arch.title')}</h2>
						<p class="lead" data-i18n="tech.arch.body">{t('tech.arch.body')}</p>
					</div>
					<div class="arch-diagram" data-reveal>
						<svg viewBox="0 0 520 400" role="img" aria-label="Arquitectura hexagonal: adaptadores, puertos y dominio">
							<rect x="8" y="8" width="504" height="384" rx="26" fill="none" stroke="var(--line-2)"></rect>
							<text class="d-ring" x="30" y="34" data-i18n="tech.diagram.adapters">{t('tech.diagram.adapters')}</text>

							<rect x="96" y="78" width="328" height="244" rx="20" fill="none" stroke="#4ce08c" stroke-opacity="0.55" stroke-dasharray="3 6"></rect>
							<text class="d-ring accent" x="116" y="102" data-i18n="tech.diagram.ports">{t('tech.diagram.ports')}</text>

							<path d="M260 138 L322 174 L322 246 L260 282 L198 246 L198 174 Z" fill="color-mix(in srgb, var(--accent) 12%, transparent)" stroke="#4ce08c"></path>
							<text class="d-dom" x="260" y="206" text-anchor="middle" data-i18n="tech.diagram.domain">{t('tech.diagram.domain')}</text>
							<text class="d-sub" x="260" y="226" text-anchor="middle" data-i18n="tech.diagram.domainsub">{t('tech.diagram.domainsub')}</text>

							<g class="d-link"><path d="M150 130 L198 174"></path><path d="M370 130 L322 174"></path><path d="M150 300 L198 246"></path><path d="M370 300 L322 246"></path></g>

							<g class="chip"><rect x="70" y="112" width="112" height="40" rx="10"></rect><text x="126" y="137" data-i18n="tech.diagram.gps">{t('tech.diagram.gps')}</text></g>
							<g class="chip"><rect x="338" y="112" width="112" height="40" rx="10"></rect><text x="394" y="137" data-i18n="tech.diagram.ped">{t('tech.diagram.ped')}</text></g>
							<g class="chip"><rect x="70" y="278" width="112" height="40" rx="10"></rect><text x="126" y="303" data-i18n="tech.diagram.db">{t('tech.diagram.db')}</text></g>
							<g class="chip"><rect x="338" y="278" width="112" height="40" rx="10"></rect><text x="394" y="303" data-i18n="tech.diagram.ui">{t('tech.diagram.ui')}</text></g>
						</svg>
					</div>
				</div>
			</section>

			<section class="band band-quiet">
				<div class="wrap">
					<div class="concepts">
						<article data-reveal>
							<span class="cnum mono">01</span>
							<h3 data-i18n="tech.stack.title">{t('tech.stack.title')}</h3>
							<p data-i18n="tech.stack.body">{t('tech.stack.body')}</p>
							<div class="tags">
								<span class="tag mono">Astro</span>
								<span class="tag mono">Vue</span>
								<span class="tag mono">Capacitor 8</span>
								<span class="tag mono">nanostores</span>
								<span class="tag mono">IndexedDB</span>
								<span class="tag mono">Leaflet</span>
								<span class="tag mono">MapLibre</span>
							</div>
						</article>
						<article data-reveal>
							<span class="cnum mono">02</span>
							<h3 data-i18n="tech.offline.title">{t('tech.offline.title')}</h3>
							<p data-i18n="tech.offline.body">{t('tech.offline.body')}</p>
						</article>
						<article data-reveal>
							<span class="cnum mono">03</span>
							<h3 data-i18n="tech.test.title">{t('tech.test.title')}</h3>
							<p data-i18n="tech.test.body">{t('tech.test.body')}</p>
						</article>
					</div>

					<div class="techstats" data-reveal>
						<div class="tstat"><b class="mono">170</b><span data-i18n="tech.stat.tests">{t('tech.stat.tests')}</span></div>
						<div class="tstat"><b class="mono">0</b><span data-i18n="tech.stat.backend">{t('tech.stat.backend')}</span></div>
						<div class="tstat"><b class="mono accent">AGPL</b><span data-i18n="tech.stat.license">{t('tech.stat.license')}</span></div>
					</div>
				</div>
			</section>

			<section class="closer">
				<div class="wrap closer-in" data-reveal>
					<p class="lead" data-i18n="tech.license">{t('tech.license')}</p>
					<a class="btn btn-lg" href={GITHUB_URL} rel="noopener">
						<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 19c-4 1.4-4-2.2-6-2.6m12 4.6v-3.4a3 3 0 00-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 00-1.3-3.2 4.3 4.3 0 00-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 00-6 0C7.9 2.9 6.9 3.2 6.9 3.2a4.3 4.3 0 00-.1 3.2A4.6 4.6 0 005.5 9.6c0 4.6 2.8 5.7 5.5 6a3 3 0 00-.8 2.3V21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
						<span data-i18n="tech.cta">{t('tech.cta')}</span>
					</a>
				</div>
			</section>
		</main>

		<footer class="foot">
			<div class="wrap foot-in">
				<a class="brand" href="/" aria-label="Rastro">
					<svg class="glyph" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
						<rect width="32" height="32" rx="7" fill="#0a0c0d" stroke="#232a2d"></rect>
						<path d="M10 27 L10 11 C10 6.5 21 6 21 12.5 C21 17 13.5 17 11 16.5 C15.5 17.5 18.5 23 22.5 27" fill="none" stroke="#4ce08c" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
						<circle cx="10" cy="27" r="2.6" fill="#eef1ee"></circle>
						<circle cx="22.5" cy="27" r="2.6" fill="none" stroke="#4ce08c" stroke-width="2"></circle>
					</svg>
					<span class="brand-name">Rastro</span>
				</a>
				<span class="foot-made cap" data-i18n="foot.license">{t('foot.license')}</span>
			</div>
		</footer>

		<script is:inline define:vars={{ strings: STRINGS }}>
			(function () {
				const KEY = 'rastro.lang';
				const nodes = document.querySelectorAll('[data-i18n]');
				function detect() {
					try { const s = localStorage.getItem(KEY); if (s === 'es' || s === 'en') return s; } catch (e) {}
					return (navigator.language || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';
				}
				function apply(lang) {
					document.documentElement.lang = lang;
					nodes.forEach(function (n) {
						const k = n.getAttribute('data-i18n');
						const entry = strings[k];
						if (entry && entry[lang]) n.textContent = entry[lang];
					});
					const btn = document.getElementById('lang');
					if (btn) btn.setAttribute('aria-pressed', String(lang === 'en'));
					try { localStorage.setItem(KEY, lang); } catch (e) {}
				}
				let lang = detect();
				apply(lang);
				const btn = document.getElementById('lang');
				if (btn) btn.addEventListener('click', function () { lang = lang === 'es' ? 'en' : 'es'; apply(lang); });

				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const reveals = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
				function reveal(n) { n.classList.add('in'); }
				if (reduce || !('IntersectionObserver' in window)) { reveals.forEach(reveal); }
				else {
					const io = new IntersectionObserver(function (entries) {
						entries.forEach(function (e) { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } });
					}, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
					reveals.forEach(function (n) { io.observe(n); });
					function sweep() {
						for (let i = reveals.length - 1; i >= 0; i--) {
							const n = reveals[i];
							if (n.classList.contains('in')) continue;
							const r = n.getBoundingClientRect();
							if (r.top < window.innerHeight * 0.92 && r.bottom > 0) { reveal(n); io.unobserve(n); }
						}
					}
					window.addEventListener('scroll', sweep, { passive: true });
					window.addEventListener('load', sweep);
					sweep();
					setTimeout(function () { reveals.forEach(reveal); }, 2200);
				}
			})();
		</script>

		<style>
			.terrain { position: fixed; inset: 0; z-index: -1; background: radial-gradient(120% 80% at 82% -8%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 46%), var(--bg); }
			.terrain svg { width: 100%; height: 100%; }
			.contours path { fill: none; stroke: var(--line); stroke-width: 1.2; opacity: 0.5; }

			.nav { position: sticky; top: 0; z-index: 50; backdrop-filter: saturate(140%) blur(12px); background: color-mix(in srgb, var(--bg) 78%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent); }
			.nav-in { display: flex; align-items: center; height: 62px; }
			.brand { display: inline-flex; align-items: center; gap: 10px; }
			.brand-name { font-family: var(--font-display); font-weight: 600; font-size: 24px; }
			.nav-right { display: flex; align-items: center; gap: var(--sp-4); margin-left: auto; }
			.backlink { font-size: 14px; color: var(--muted); transition: color 0.15s ease; }
			.backlink:hover { color: var(--ink); }
			.lang { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; color: var(--muted); background: transparent; border: 1px solid var(--line-2); border-radius: 8px; padding: 6px 10px; cursor: pointer; transition: color 0.15s ease, border-color 0.15s ease; }
			.lang:hover { color: var(--ink); border-color: var(--faint); }

			.btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; font-family: var(--font-display); font-weight: 600; font-size: 18px; color: var(--accent-ink); background: var(--accent); border: 1px solid transparent; border-radius: 12px; padding: 14px 24px; cursor: pointer; transition: transform 0.16s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.16s ease; }
			.btn:hover { transform: translateY(-2px); box-shadow: 0 12px 30px -12px color-mix(in srgb, var(--accent) 60%, transparent); }

			.thero { padding: clamp(48px, 8vw, 96px) 0 clamp(24px, 4vw, 40px); }
			.hero-title { font-size: clamp(44px, 8vw, 92px); line-height: 0.94; letter-spacing: -0.02em; text-transform: uppercase; }
			.hero-title em { color: var(--accent); font-style: normal; }
			.lead { margin-top: var(--sp-4); font-size: clamp(16px, 2vw, 19px); color: var(--muted); max-width: 62ch; }
			.lead.big { font-size: clamp(18px, 2.4vw, 22px); max-width: 54ch; }

			.band { padding: clamp(48px, 8vw, 104px) 0; }
			.band-quiet { background: color-mix(in srgb, var(--bg-2) 60%, transparent); }
			h2 { font-size: clamp(30px, 4.6vw, 52px); text-transform: uppercase; }
			h3 { font-size: 24px; text-transform: uppercase; }

			.arch { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
			.arch-diagram svg { width: 100%; height: auto; }
			.d-ring { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--faint); }
			.d-ring.accent { fill: var(--accent); }
			.d-dom { font-family: var(--font-display); font-size: 20px; text-transform: uppercase; fill: var(--ink); }
			.d-sub { font-family: var(--font-mono); font-size: 11px; fill: var(--muted); }
			.d-link path { stroke: var(--line-2); stroke-width: 1.5; }
			.chip rect { fill: color-mix(in srgb, var(--surface) 90%, transparent); stroke: var(--line-2); }
			.chip text { font-family: var(--font-mono); font-size: 13px; fill: var(--ink); text-anchor: middle; dominant-baseline: middle; }

			.concepts { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); margin-bottom: var(--sp-8); }
			.concepts article { border-top: 2px solid var(--accent); padding-top: var(--sp-4); }
			.cnum { display: block; font-size: 13px; color: var(--accent); margin-bottom: var(--sp-3); }
			.concepts h3 { margin-bottom: var(--sp-3); }
			.concepts p { color: var(--muted); font-size: 15.5px; }
			.tags { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-4); }
			.tag { font-size: 12px; color: var(--muted); border: 1px solid var(--line-2); border-radius: 8px; padding: 5px 10px; }

			.techstats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; }
			.tstat { background: color-mix(in srgb, var(--surface) 82%, var(--bg)); padding: var(--sp-6) var(--sp-4); text-align: center; }
			.tstat b { display: block; font-size: clamp(30px, 5vw, 48px); font-weight: 700; }
			.tstat span { font-size: 12.5px; color: var(--muted); }

			.closer { padding: clamp(56px, 9vw, 120px) 0; text-align: center; }
			.closer-in { max-width: 44ch; margin-inline: auto; display: flex; flex-direction: column; align-items: center; gap: var(--sp-5); }
			.mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
			.accent { color: var(--accent); }

			.foot { border-top: 1px solid var(--line); padding: var(--sp-7) 0; background: var(--bg-2); }
			.foot-in { display: flex; align-items: center; gap: var(--sp-5); }
			.foot-made { margin-left: auto; color: var(--faint); }

			.js [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
			.js [data-reveal].in { opacity: 1; transform: none; }
			@media (prefers-reduced-motion: reduce) { .js [data-reveal] { opacity: 1; transform: none; transition: none; } }

			@media (max-width: 900px) {
				.arch { grid-template-columns: 1fr; }
				.concepts { grid-template-columns: 1fr; }
			}
			@media (max-width: 560px) {
				.techstats { grid-template-columns: 1fr; }
			}
		</style>
	</body>
</html>
