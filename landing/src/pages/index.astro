		<script is:inline define:vars={{ strings: STRINGS }}>
			(function () {
				const KEY = 'rastro.lang';
				const nodes = document.querySelectorAll('[data-i18n]');
				const labelNodes = document.querySelectorAll('[data-i18n-label]');
				function detect() {
					try {
						const s = localStorage.getItem(KEY);
						if (s === 'es' || s === 'en') return s;
					} catch (e) {}
					return (navigator.language || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';
				}
				function apply(lang) {
					document.documentElement.lang = lang;
					nodes.forEach(function (n) {
						const k = n.getAttribute('data-i18n');
						const entry = strings[k];
						if (entry && entry[lang]) n.textContent = entry[lang];
					});
					labelNodes.forEach(function (n) {
						const k = n.getAttribute('data-i18n-label');
						const entry = strings[k];
						if (entry && entry[lang]) n.setAttribute('aria-label', entry[lang]);
					});
					const btn = document.getElementById('lang');
					if (btn) btn.setAttribute('aria-pressed', String(lang === 'en'));
					try { localStorage.setItem(KEY, lang); } catch (e) {}
				}
				let lang = detect();
				apply(lang);
				const btn = document.getElementById('lang');
				if (btn) btn.addEventListener('click', function () {
					lang = lang === 'es' ? 'en' : 'es';
					apply(lang);
				});

				// One authored reveal — sections rise as they enter. Belt-and-suspenders:
				// the observer staggers on scroll, a scroll sweep backs it up, and a hard
				// fallback guarantees content is NEVER left hidden (bad JS timing, jump links).
				const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const reveals = Array.prototype.slice.call(document.querySelectorAll('[data-reveal]'));
				function reveal(n) { n.classList.add('in'); }
				if (reduce || !('IntersectionObserver' in window)) {
					reveals.forEach(reveal);
				} else {
					const io = new IntersectionObserver(function (entries) {
						entries.forEach(function (e) {
							if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); }
						});
					}, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
					reveals.forEach(function (n) { io.observe(n); });
					function sweep() {
						for (let i = reveals.length - 1; i >= 0; i--) {
							const n = reveals[i];
							if (n.classList.contains('in')) continue;
							const r = n.getBoundingClientRect();
							if (r.top < window.innerHeight * 0.92 && r.bottom > 0) { reveal(n); io.unobserve(n); }
						}
					}
					window.addEventListener('scroll', sweep, { passive: true });
					window.addEventListener('resize', sweep, { passive: true });
					window.addEventListener('load', sweep);
					sweep();
					// Last resort: nothing stays invisible past this point, ever.
					setTimeout(function () { reveals.forEach(reveal); }, 2200);
				}

				// Share deck — three visible slots (left / center / right) ROTATE through a
				// pool of six designs: every advance shifts all three (a new design enters
				// at the right, the center slides to the left, the old left retires).
				// The dots are real buttons: manual navigation always works, including under
				// reduced motion, where the deck never auto-advances and swaps are instant.
				const deck = document.getElementById('shareDeck');
				if (deck) {
					const holder = deck.closest('.share-stage') || deck;
					const cards = Array.prototype.slice.call(deck.querySelectorAll('.dcard'));
					const dots = Array.prototype.slice.call(document.querySelectorAll('.deck-dots button'));
					const n = cards.length;
					let idx = 0, timer = null;
					function layout() {
						cards.forEach(function (c, i) {
							const off = (i - idx + n) % n;
							c.classList.remove('pos-c', 'pos-r', 'pos-l', 'pos-back');
							if (off === 0) c.classList.add('pos-c');
							else if (off === 1) c.classList.add('pos-r');
							else if (off === n - 1) c.classList.add('pos-l');
							else c.classList.add('pos-back');
							if (off === 0) c.removeAttribute('aria-hidden');
							else c.setAttribute('aria-hidden', 'true');
						});
						dots.forEach(function (d, i) {
							if (i === idx) d.setAttribute('aria-current', 'true');
							else d.removeAttribute('aria-current');
						});
					}
					function show(next) { idx = (next + n) % n; layout(); }
					function start() { if (!reduce && !timer) timer = window.setInterval(function () { show(idx + 1); }, 3800); }
					function stop() { if (timer) { clearInterval(timer); timer = null; } }
					dots.forEach(function (d, i) {
						d.addEventListener('click', function () { stop(); show(i); start(); });
					});
					start();
					// Pause while hovered or focused so a reader can dwell on one design,
					// and while the tab is hidden so it doesn't cycle unseen.
					holder.addEventListener('mouseenter', stop);
					holder.addEventListener('mouseleave', start);
					holder.addEventListener('focusin', stop);
					holder.addEventListener('focusout', function (e) {
						if (!holder.contains(e.relatedTarget)) start();
					});
					document.addEventListener('visibilitychange', function () {
						if (document.hidden) stop(); else start();
					});
				}
			})();
