			.hud-cell span { font-size: 10px; color: var(--muted); text-transform: capitalize; }
			.hud-cell i { font-size: 9.5px; color: var(--faint); font-style: normal; }

			/* ---------- Bands ---------- */
			.band { padding: clamp(56px, 9vw, 120px) 0; }
			.band-quiet { background: color-mix(in srgb, var(--bg-2) 60%, transparent); }
			.band-head { max-width: 60ch; margin-bottom: var(--sp-8); }
			h2 { font-size: clamp(34px, 5.5vw, 60px); text-transform: uppercase; }
			.lead { margin-top: var(--sp-4); font-size: clamp(16px, 2vw, 19px); color: var(--muted); max-width: 62ch; }
			.split-title { font-size: clamp(38px, 6vw, 72px); text-transform: uppercase; line-height: 0.92; }
			.split-title.big { font-size: clamp(40px, 7vw, 84px); }
			.split-title em { color: var(--accent); font-style: normal; }

			.band-tight { padding-top: 0; }

			/* Modes — one instrument panel, three cells split by rules */
			.modes {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				background: color-mix(in srgb, var(--surface) 60%, transparent);
				border: 1px solid var(--line);
				border-radius: var(--radius-lg);
				overflow: hidden;
			}
			.mode { padding: var(--sp-6) var(--sp-5); }
