					linear-gradient(150deg, #3a1d6b 0%, #10203a 52%, #0a2a1c 100%);
			}
			.dc-big { display: flex; flex-direction: column; gap: 2px; }
			.dc-big b { font-size: 46px; line-height: 1; font-family: var(--font-mono); color: #fff; }

			/* topographic card */
			.dc-topo { background: linear-gradient(180deg, #0d1512 0%, #0a0c0d 100%); }
			.dc-topo-lines path { fill: none; stroke: color-mix(in srgb, var(--accent) 30%, transparent); stroke-width: 1.2; }

			/* blueprint / coordinate card */
			.dc-blue-marks path { stroke: color-mix(in srgb, var(--accent) 45%, transparent); stroke-width: 1.2; }
			.dc-blue-coord {
				font-family: var(--font-mono);
				font-size: 11px;
				letter-spacing: 0.1em;
				fill: color-mix(in srgb, var(--accent) 75%, #eef1ee);
			}
			.dc-blue-bg > path { filter: drop-shadow(0 0 3px color-mix(in srgb, var(--accent) 60%, transparent)); }

			/* big typographic card */
			.dc-type { background: linear-gradient(180deg, #0e1113 0%, #0a0c0d 100%); }
			.dc-type-in {
				position: absolute;
				inset: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				padding: var(--sp-5);
			}
			.dc-type-in b {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 96px;
				line-height: 0.9;
				letter-spacing: -0.03em;
				color: var(--ink);
			}
			.dc-type-km { color: var(--accent); margin-top: 6px; }
			.dc-type-time { font-size: 15px; color: var(--muted); margin-top: 10px; }

			/* share features — a four-cell legend row */
			.feat-legend {
				list-style: none;
				margin: var(--sp-7) 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				border-top: 1px solid var(--line-2);
				border-bottom: 1px solid var(--line);
			}
			.feat-legend li {
				display: flex;
				align-items: center;
				gap: var(--sp-3);
				padding: var(--sp-5) var(--sp-4);
				font-size: 15.5px;
			}
			.feat-legend li + li { border-left: 1px solid var(--line); }
			.ico-sm { width: 26px; height: 26px; color: var(--ink); flex: none; }

			/* exercise features — vertical list */
			.featlist { list-style: none; margin: var(--sp-5) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-4); }
			.featlist li { display: flex; align-items: center; gap: var(--sp-3); font-size: 16.5px; }

			/* Privacy — statement + registered legend */
			.privacy-copy { max-width: 68ch; }
			.pledge {
				list-style: none;
				margin: var(--sp-7) 0 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				border: 1px solid var(--line-2);
				background: color-mix(in srgb, var(--surface) 55%, transparent);
			}
			.pledge li {
				display: flex;
				gap: var(--sp-4);
				align-items: flex-start;
				padding: var(--sp-6) var(--sp-5);
			}
			.pledge li + li { border-left: 1px solid var(--line); }
			.pledge li div { display: flex; flex-direction: column; }
			.pledge b { font-family: var(--font-display); font-size: 24px; font-weight: 700; text-transform: uppercase; }
			.pledge span { color: var(--muted); font-size: 14.5px; }

			/* Exercises */
			.exercise { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 5vw, 68px); align-items: center; }
			.exercise-panel {
				background: linear-gradient(180deg, var(--surface) 0%, var(--bg-2) 100%);
				border: 1px solid var(--line-2);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow);
				overflow: hidden;
			}
			.exercise-panel.reg { overflow: visible; }
			.exercise-panel.reg > .repcard,
			.exercise-panel.reg > .routine { border-radius: inherit; }
			.repcard { padding: var(--sp-5); border-bottom: 1px solid var(--line); }
			.repcount { display: flex; align-items: baseline; gap: var(--sp-3); margin: var(--sp-3) 0; }
			.repcount b { font-family: var(--font-mono); font-size: clamp(44px, 8vw, 62px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
			.repname { font-family: var(--font-display); font-size: 24px; text-transform: uppercase; }
			.repdots { display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; margin-bottom: var(--sp-3); }
			.repdots span { height: 8px; border-radius: 999px; background: var(--accent); }
			.routine { padding: var(--sp-5); }
			.steps { list-style: none; margin: var(--sp-3) 0 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
			.step { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-3); border-radius: var(--radius); font-size: 15.5px; }
			.step i { margin-left: auto; font-size: 13px; color: var(--muted); font-style: normal; }
			.step-ico { width: 20px; height: 20px; color: var(--muted); flex: none; }
			.step-node { width: 12px; height: 12px; border-radius: 999px; border: 2px solid var(--accent); flex: none; margin: 0 4px; }
			.step-node.dim { border-color: var(--line-2); }
			.step.done { color: var(--muted); }
			.step.done span { text-decoration: line-through; text-decoration-color: var(--line-2); }
			.step.now { background: color-mix(in srgb, var(--accent) 12%, transparent); font-weight: 500; }
			.step.now .step-node { background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
			.step.rest { color: var(--muted); }
			.step.rest i { color: var(--accent); }

			/* Roadmap — a GPS track of what's next */
			.roadmap { list-style: none; margin: 0; padding: 0; position: relative; max-width: 760px; }
			.roadmap::before { content: ''; position: absolute; left: 7px; top: 14px; bottom: 14px; width: 2px; background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 18%, transparent)); }
			/* the track draws downward as the list enters — same language as the hero route */
			.js .roadmap::before { transform: scaleY(0); transform-origin: top; transition: transform 1.2s cubic-bezier(0.3, 0.9, 0.2, 1) 0.2s; }
			.js .roadmap.in::before { transform: none; }
			.road-item { position: relative; display: flex; padding: var(--sp-5) 0 var(--sp-5) var(--sp-6); }
			.road-item + .road-item { border-top: 1px solid var(--line); }
			.road-node { position: absolute; left: 0; top: calc(var(--sp-5) + 4px); width: 16px; height: 16px; border-radius: 999px; background: var(--bg); border: 2px solid var(--accent); }
			.road-node.end { background: var(--accent); }
			.road-top { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
			.road-code { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.16em; color: var(--faint); }
			.road-top b { font-family: var(--font-display); font-size: 24px; font-weight: 700; text-transform: uppercase; }
			.road-tag { color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 999px; padding: 3px 9px; }
			.road-body p { color: var(--muted); font-size: 15px; margin-top: 5px; max-width: 60ch; }

			/* Closer */
			.closer { padding: clamp(64px, 11vw, 148px) 0; text-align: center; }
			.closer-in { max-width: 44ch; margin-inline: auto; display: flex; flex-direction: column; align-items: center; }
			.closer-glyph { margin-bottom: var(--sp-4); }
			/* the R traces itself once more at the exit — a bookend to the hero */
			.js .closer-glyph path { stroke-dasharray: 96; stroke-dashoffset: 96; }
			.js .closer-in.in .closer-glyph path { animation: draw 1.6s cubic-bezier(0.3, 0.9, 0.2, 1) 0.2s forwards; }
			.closer h2 { font-size: clamp(44px, 8vw, 92px); text-transform: uppercase; }
			.closer .lead { margin-inline: auto; }
			.closer .hero-cta { margin-top: var(--sp-6); }
			.dl-req { margin-top: var(--sp-5); }
			.dl-stamp { margin-top: var(--sp-3); color: var(--faint); }

			/* Footer */
			.foot { border-top: 1px solid var(--line); padding: var(--sp-7) 0; background: var(--bg-2); }
			.foot-in { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; }
			.foot-brand { display: flex; align-items: center; gap: var(--sp-3); }
			.foot-brand div { display: flex; flex-direction: column; }
			.foot-brand b { font-family: var(--font-display); font-size: 18px; }
			.foot-tag { font-size: 12.5px; color: var(--muted); }
			.foot-links { display: flex; gap: var(--sp-5); margin-left: auto; font-size: 14px; color: var(--muted); flex-wrap: wrap; }
			.foot-links a { transition: color 0.15s ease; }
			.foot-links a:hover { color: var(--ink); }
			.foot-row {
				flex-basis: 100%;
				display: flex;
				justify-content: space-between;
				gap: var(--sp-4);
				flex-wrap: wrap;
				border-top: 1px solid var(--line);
				padding-top: var(--sp-4);
			}
			.foot-coord { color: var(--faint); }

			/* ---------- Reveal (progressive: hidden only when JS is present) ---------- */
			.js [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
			.js [data-reveal].in { opacity: 1; transform: none; }
			@media (prefers-reduced-motion: reduce) {
				.js [data-reveal] { opacity: 1; transform: none; transition: none; }
				.js .hero-stage[data-reveal] .ht-l { opacity: 1; transform: none; transition: none; }
				.route-line { stroke-dashoffset: 0 !important; animation: none !important; }
				.dcard { transition: none; }
				.js .km, .js .p-end { opacity: 1; animation: none !important; }
				.scope-live::after { animation: none; }
				.js .splits span::before { transform: none; transition: none; }
				.js .roadmap::before { transform: none; transition: none; }
				.js .closer-glyph path { stroke-dashoffset: 0; animation: none !important; }
				.nav-links a::after { transition: none; }
				.deck-dots button::before { transition: none; }
				.mode { transition: none; }
			}

			/* ---------- Responsive ---------- */
			@media (max-width: 1180px) {
				.nav-coord { display: none; }
			}
			@media (max-width: 1040px) {
				.hero-stage { display: flex; flex-direction: column; gap: var(--sp-6); }
				.hero-scope {
					position: static;
					width: min(100%, 440px);
					transform: none;
					order: 2;
				}
				.hero-under { max-width: none; }
				.hud-meta { flex-basis: 100%; margin-left: 0; }
			}
			@media (max-width: 900px) {
				.analysis, .exercise { grid-template-columns: 1fr; }
				.analysis-copy, .exercise-copy { order: -1; }
				.nav-links { display: none; }
				.mode { grid-template-columns: 56px 1fr; }
				.mode p { grid-column: 2; padding-top: 0; }
				.mode-code { padding-top: 10px; }
				.feat-legend { grid-template-columns: 1fr 1fr; }
				.feat-legend li + li { border-left: none; }
				.feat-legend li:nth-child(even) { border-left: 1px solid var(--line); }
				.feat-legend li:nth-child(n + 3) { border-top: 1px solid var(--line); }
				.pledge { grid-template-columns: 1fr; }
				.pledge li + li { border-left: none; border-top: 1px solid var(--line); }
			}
			@media (max-width: 620px) {
				.statcluster { grid-template-columns: repeat(2, 1fr); }
				.sl-coord { display: none; }
				.orbit { height: 300px; }
				.dcard { width: 200px; }
				.pos-r { transform: translate(calc(-50% + 128px), -50%) scale(0.74) rotate(4deg); opacity: 0.55; }
				.pos-l { transform: translate(calc(-50% - 128px), -50%) scale(0.74) rotate(-4deg); opacity: 0.55; }
				.dc-type-in b { font-size: 76px; }
				.hud-cell b { font-size: 17px; }
				.feat-legend { grid-template-columns: 1fr; }
				.feat-legend li:nth-child(even) { border-left: none; }
				.feat-legend li + li { border-top: 1px solid var(--line); }
			}
		</style>
	</body>
</html>
