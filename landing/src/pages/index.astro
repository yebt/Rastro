			.hero-cta.center { justify-content: center; }
			.hero-note { margin-top: var(--sp-5); }

			/* Instrument scope */
			.hero-instrument { display: flex; justify-content: center; }
			.scope {
				position: relative;
				width: min(100%, 460px);
				background: linear-gradient(180deg, var(--surface) 0%, var(--bg-2) 100%);
				border: 1px solid var(--line-2);
				border-radius: var(--radius-lg);
				padding: var(--sp-5);
				box-shadow: var(--shadow-lg);
			}
			.scope-cap { position: absolute; top: 14px; left: 18px; z-index: 2; }
			.route { width: 100%; height: auto; border-radius: var(--radius); overflow: hidden; }
			.tilt { transform: perspective(760px) rotateX(20deg) rotateZ(-11deg); transform-origin: 55% 60%; }
			.route-line {
				stroke-dasharray: 640;
				filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 55%, transparent));
			}
			.js .route-line { stroke-dashoffset: 640; }
			.js .hero-instrument.in .route-line { animation: draw 2.1s cubic-bezier(0.3, 0.9, 0.2, 1) 0.25s forwards; }
			@keyframes draw { to { stroke-dashoffset: 0; } }
			.km { fill: var(--bg); stroke: var(--accent); stroke-width: 2; }
			.p-start { fill: var(--ink); }
			.p-end { fill: var(--bg); stroke: var(--accent); stroke-width: 3; }
			.hud {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: var(--sp-2);
				margin-top: var(--sp-4);
				padding-top: var(--sp-4);
