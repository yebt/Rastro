---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL, RELEASES_URL } from '../consts';
import { STRINGS } from '../i18n';

// Single source of truth for copy: render Spanish at build, toggle swaps textContent.
const t = (k: string): string => STRINGS[k]?.es ?? k;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${SITE_TITLE} — ${STRINGS['hero.title1'].es} ${STRINGS['hero.title2'].es}`} description={SITE_DESCRIPTION} />
		<!-- Progressive enhancement flag: content is visible by default; reveals only arm when JS runs. -->
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<!--
		DIRECTION CONTRACT — Rastro landing · seed a15b0ba6 · FORM: map-first immersion (7/7 of my grounded list)
		THESIS: The landing is the instrument, not a brochure about it. Refuses the SaaS hero+3-card rut: the product's own map and readouts ARE the page.
		OWN-WORLD: Inherited app skin — near-black #0a0c0d ground, one signal green #4ce08c, Barlow Condensed display, Space Mono numerals; a persistent faint topographic map behind instrument-surface panels; drawn route glyphs, no stock chrome.
		STORY: Visitor sees a real recorded run, believes the measurement + privacy promise, downloads the APK or reads the source.
		FIRST VIEWPORT: Full-bleed dark terrain; a large tilted route draws itself; headline left, HUD readout strip below, primary "Descargar APK" in accent.
		FORM: map-first immersion; panels rise over a fixed map ground; seed key a15b0ba6.
		FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
		-->

		<!-- Persistent topographic map ground -->
		<div class="terrain" aria-hidden="true">
			<svg viewBox="0 0 1200 1600" preserveAspectRatio="xMidYMid slice">
				<g class="contours">
					<path d="M-100 300 C 200 220 420 380 640 300 S 1080 200 1320 320" />
					<path d="M-100 420 C 220 340 440 500 660 420 S 1080 320 1320 440" />
					<path d="M-100 560 C 240 470 470 640 700 560 S 1100 460 1320 590" />
					<path d="M-100 720 C 260 620 500 800 760 720 S 1120 620 1320 760" />
					<path d="M-100 900 C 300 790 540 980 800 900 S 1140 800 1320 940" />
					<path d="M-100 1100 C 320 980 560 1180 840 1100 S 1160 1000 1320 1150" />
					<path d="M-100 1320 C 340 1200 600 1400 880 1320 S 1180 1220 1320 1380" />
				</g>
			</svg>
		</div>

		<header class="nav">
			<div class="wrap nav-in">
				<a class="brand" href="#top" aria-label="Rastro">
					<svg class="glyph" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
						<rect width="32" height="32" rx="7" fill="#4ce08c"></rect>
						<g fill="none" stroke="#0a0c0d" stroke-width="4.7" stroke-linecap="round" stroke-linejoin="miter" transform="skewX(-8) translate(2.2 0)">
							<path d="M11 25.2 L11 6.8 L19.2 6.8 L23.4 11 L23.4 12.8 L19.2 17 L11 17"></path>
							<path d="M15 17 L23.4 25.2"></path>
						</g>
					</svg>
					<span class="brand-name">Rastro</span>
				</a>
				<nav class="nav-links" aria-label="Secciones">
					<a href="#records" data-i18n="nav.records">{t('nav.records')}</a>
					<a href="#analysis" data-i18n="nav.analysis">{t('nav.analysis')}</a>
					<a href="#share" data-i18n="nav.share">{t('nav.share')}</a>
					<a href="#privacy" data-i18n="nav.privacy">{t('nav.privacy')}</a>
					<a href={GITHUB_URL} data-i18n="nav.dev" rel="noopener">{t('nav.dev')}</a>
				</nav>
				<div class="nav-right">
					<button id="lang" class="lang" type="button" aria-label="English / Español" data-i18n="cta.lang">{t('cta.lang')}</button>
					<a class="btn btn-sm" href={RELEASES_URL} rel="noopener" data-i18n="cta.download">{t('cta.download')}</a>
				</div>
			</div>
		</header>

		<main id="top">
			<!-- HERO -->
			<section class="hero">
				<div class="wrap hero-in">
					<div class="hero-copy" data-reveal>
						<h1 class="hero-title">
							<span data-i18n="hero.title1">{t('hero.title1')}</span><br />
							<em data-i18n="hero.title2">{t('hero.title2')}</em>
						</h1>
						<p class="hero-sub" data-i18n="hero.sub">{t('hero.sub')}</p>
						<div class="hero-cta">
							<a class="btn btn-lg" href={RELEASES_URL} rel="noopener">
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 3v12m0 0l-4.5-4.5M12 15l4.5-4.5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								<span data-i18n="cta.download">{t('cta.download')}</span>
							</a>
							<a class="btn btn-ghost btn-lg" href={GITHUB_URL} rel="noopener">
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 19c-4 1.4-4-2.2-6-2.6m12 4.6v-3.4a3 3 0 00-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.6 4.6 0 00-1.3-3.2 4.3 4.3 0 00-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 00-6 0C7.9 2.9 6.9 3.2 6.9 3.2a4.3 4.3 0 00-.1 3.2A4.6 4.6 0 005.5 9.6c0 4.6 2.8 5.7 5.5 6a3 3 0 00-.8 2.3V21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								<span data-i18n="cta.source">{t('cta.source')}</span>
							</a>
						</div>
						<p class="hero-note cap" data-i18n="hero.note">{t('hero.note')}</p>
					</div>

					<div class="hero-instrument" data-reveal>
						<div class="scope">
							<span class="scope-cap cap" data-i18n="hero.kicker">{t('hero.kicker')}</span>
							<svg class="route" viewBox="0 0 420 300" role="img" aria-label="Recorrido de ejemplo">
								<defs>
									<pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse">
										<circle cx="1.5" cy="1.5" r="1.1" fill="#1b2124"></circle>
									</pattern>
								</defs>
								<g class="tilt">
									<rect x="-40" y="-20" width="500" height="360" fill="url(#dots)"></rect>
									<path class="route-line" d="M60 250 C 110 230 96 150 150 140 C 210 128 210 210 270 190 C 330 172 300 90 370 60" fill="none" stroke="#4ce08c" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
									<circle class="km" cx="150" cy="140" r="3.2"></circle>
									<circle class="km" cx="270" cy="190" r="3.2"></circle>
									<circle class="p-start" cx="60" cy="250" r="7"></circle>
									<circle class="p-end" cx="370" cy="60" r="7.5"></circle>
								</g>
							</svg>
							<div class="hud">
								<div class="hud-cell"><b class="mono">7.42</b><span data-i18n="hero.stat.dist">{t('hero.stat.dist')}</span><i class="mono">km</i></div>
								<div class="hud-cell"><b class="mono">5'18"</b><span data-i18n="hero.stat.pace">{t('hero.stat.pace')}</span><i class="mono">/km</i></div>
								<div class="hud-cell"><b class="mono">168</b><span data-i18n="hero.stat.cad">{t('hero.stat.cad')}</span><i class="mono">spm</i></div>
								<div class="hud-cell"><b class="mono">+214</b><span data-i18n="hero.stat.elev">{t('hero.stat.elev')}</span><i class="mono">m</i></div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- MODES -->
			<section id="records" class="band band-tight">
				<div class="wrap">
					<header class="band-head" data-reveal>
						<h2 data-i18n="rec.title">{t('rec.title')}</h2>
						<p class="lead" data-i18n="rec.sub">{t('rec.sub')}</p>
					</header>
					<div class="modes" data-reveal>
						<article class="mode">
							<div class="mode-head">
								<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19c3-1.4 2.4-5.4 5-6s4.4-2.2 6.6-4.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="4" cy="19" r="2" fill="currentColor"></circle><circle cx="18.5" cy="6.5" r="2" fill="none" stroke="var(--accent)" stroke-width="1.8"></circle></svg>
								<h3 data-i18n="rec.move.t">{t('rec.move.t')}</h3>
							</div>
							<p data-i18n="rec.move.d">{t('rec.move.d')}</p>
						</article>
						<article class="mode">
							<div class="mode-head">
								<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
								<h3 data-i18n="rec.exercise.t">{t('rec.exercise.t')}</h3>
							</div>
							<p data-i18n="rec.exercise.d">{t('rec.exercise.d')}</p>
						</article>
						<article class="mode">
							<div class="mode-head">
								<svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><path d="M4 6l1 1 1.5-2M4 12l1 1 1.5-2M4 18l1 1 1.5-2" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								<h3 data-i18n="rec.routine.t">{t('rec.routine.t')}</h3>
							</div>
							<p data-i18n="rec.routine.d">{t('rec.routine.d')}</p>
						</article>
					</div>
				</div>
			</section>

			<!-- ANALYSIS -->
			<section id="analysis" class="band">
				<div class="wrap analysis">
					<div class="analysis-copy" data-reveal>
						<h2 class="split-title">
							<span data-i18n="an.title1">{t('an.title1')}</span><br />
							<em data-i18n="an.title2">{t('an.title2')}</em>
						</h2>
						<p class="lead" data-i18n="an.sub">{t('an.sub')}</p>
						<div class="statcluster">
							<div class="stat"><b class="mono">128.4</b><i class="mono">km</i><span data-i18n="an.stat.total">{t('an.stat.total')}</span></div>
							<div class="stat"><b class="mono">11:42</b><i class="mono">h</i><span data-i18n="an.stat.time">{t('an.stat.time')}</span></div>
							<div class="stat"><b class="mono">4'52"</b><i class="mono">/km</i><span data-i18n="an.stat.best">{t('an.stat.best')}</span></div>
							<div class="stat"><b class="mono">612</b><i class="mono">kcal</i><span data-i18n="an.stat.cal">{t('an.stat.cal')}</span></div>
							<div class="stat"><b class="mono">+214</b><i class="mono">m</i><span data-i18n="an.stat.gain">{t('an.stat.gain')}</span></div>
							<div class="stat"><b class="mono accent">7</b><i class="mono">×</i><span data-i18n="an.stat.seg">{t('an.stat.seg')}</span></div>
						</div>
					</div>

					<div class="panel" data-reveal>
						<div class="panel-block">
							<div class="panel-cap"><span class="cap" data-i18n="an.insights.cap">{t('an.insights.cap')}</span><svg class="medal" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="5" fill="none" stroke="var(--accent)" stroke-width="1.8"></circle><path d="M9 13l-2 8 5-3 5 3-2-8" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linejoin="round"></path></svg></div>
							<ul class="insights">
								<li data-i18n="an.insight1">{t('an.insight1')}</li>
								<li data-i18n="an.insight2">{t('an.insight2')}</li>
								<li data-i18n="an.insight3">{t('an.insight3')}</li>
							</ul>
						</div>

						<div class="panel-block">
							<span class="cap" data-i18n="an.splits.cap">{t('an.splits.cap')}</span>
							<div class="splits" role="img" aria-label="Ritmo por kilómetro">
								<span style="--h:56%"><i class="mono">1</i></span>
								<span style="--h:72%"><i class="mono">2</i></span>
								<span style="--h:92%" class="best"><i class="mono">3</i></span>
								<span style="--h:64%"><i class="mono">4</i></span>
								<span style="--h:80%"><i class="mono">5</i></span>
								<span style="--h:70%"><i class="mono">6</i></span>
								<span style="--h:48%"><i class="mono">7</i></span>
							</div>
						</div>

						<div class="panel-block">
							<div class="panel-cap"><span class="cap" data-i18n="an.elev.cap">{t('an.elev.cap')}</span><b class="mono">+214 / −188 m</b></div>
							<svg class="curve" viewBox="0 0 320 68" preserveAspectRatio="none" role="img" aria-label="Perfil de altitud">
								<path d="M0 58 L28 50 L60 54 L96 33 L128 39 L164 19 L200 27 L240 12 L280 30 L320 22" fill="none" stroke="#97a09a" stroke-width="2" stroke-linejoin="round"></path>
								<path d="M0 58 L28 50 L60 54 L96 33 L128 39 L164 19 L200 27 L240 12 L280 30 L320 22 L320 68 L0 68 Z" fill="url(#elevf)"></path>
								<defs><linearGradient id="elevf" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#97a09a" stop-opacity="0.16"></stop><stop offset="1" stop-color="#97a09a" stop-opacity="0"></stop></linearGradient></defs>
							</svg>
						</div>

						<div class="panel-block">
							<div class="panel-cap"><span class="cap" data-i18n="an.cadence.cap">{t('an.cadence.cap')}</span><b class="mono accent">168 spm</b></div>
							<svg class="curve" viewBox="0 0 320 90" preserveAspectRatio="none" role="img" aria-label="Curva de cadencia">
								<path d="M0 78 C 60 70 90 30 160 24 C 210 20 250 40 320 64" fill="none" stroke="#4ce08c" stroke-width="2.4" stroke-linecap="round"></path>
								<path d="M0 78 C 60 70 90 30 160 24 C 210 20 250 40 320 64 L 320 90 L 0 90 Z" fill="url(#cad)"></path>
								<defs><linearGradient id="cad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4ce08c" stop-opacity="0.22"></stop><stop offset="1" stop-color="#4ce08c" stop-opacity="0"></stop></linearGradient></defs>
								<circle cx="160" cy="24" r="3.5" fill="#eef1ee"></circle>
							</svg>
							<p class="panel-note" data-i18n="an.cadence.note">{t('an.cadence.note')}</p>
						</div>
					</div>
				</div>
			</section>

			<!-- EXERCISES -->
			<section id="exercises" class="band band-quiet">
				<div class="wrap exercise">
					<div class="exercise-panel" data-reveal>
						<div class="repcard">
							<span class="cap" data-i18n="ex.reps.cap">{t('ex.reps.cap')}</span>
							<div class="repcount">
								<b class="mono">12</b>
								<span class="repname" data-i18n="ex.name1">{t('ex.name1')}</span>
							</div>
							<div class="repdots" aria-hidden="true">
								<span></span><span></span><span></span><span></span><span></span><span></span>
								<span></span><span></span><span></span><span></span><span></span><span></span>
							</div>
							<p class="panel-note" data-i18n="ex.reps.note">{t('ex.reps.note')}</p>
						</div>
						<div class="routine">
							<span class="cap" data-i18n="ex.routine.cap">{t('ex.routine.cap')}</span>
							<ul class="steps">
								<li class="step done">
									<svg class="step-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4 10-11" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
									<span data-i18n="ex.name2">{t('ex.name2')}</span><i class="mono">20×</i>
								</li>
								<li class="step now">
									<span class="step-node" aria-hidden="true"></span>
									<span data-i18n="ex.name1">{t('ex.name1')}</span><i class="mono">12×</i>
								</li>
								<li class="step rest">
									<svg class="step-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 13V9M9 3h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
									<span data-i18n="ex.routine.rest">{t('ex.routine.rest')}</span><i class="mono">0:45</i>
								</li>
								<li class="step">
									<span class="step-node dim" aria-hidden="true"></span>
									<span data-i18n="ex.name3">{t('ex.name3')}</span><i class="mono">15×</i>
								</li>
							</ul>
						</div>
					</div>

					<div class="exercise-copy" data-reveal>
						<h2 class="split-title">
							<span data-i18n="ex.title1">{t('ex.title1')}</span><br />
							<em data-i18n="ex.title2">{t('ex.title2')}</em>
						</h2>
						<p class="lead" data-i18n="ex.sub">{t('ex.sub')}</p>
						<ul class="share-feats">
							<li><svg class="ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h11M4 12h11M4 18h11" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path><path d="M19 5l1.5 1.5L23 4" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg><span data-i18n="ex.f1">{t('ex.f1')}</span></li>
							<li><svg class="ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6M7 7v10M17 7v10M20 9v6M7 12h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg><span data-i18n="ex.f2">{t('ex.f2')}</span></li>
							<li><svg class="ico-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="8" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 13V8M9 2h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg><span data-i18n="ex.f3">{t('ex.f3')}</span></li>
							<li><svg class="ico-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M9 13l-2 8 5-3 5 3-2-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg><span data-i18n="ex.f4">{t('ex.f4')}</span></li>
						</ul>
					</div>
				</div>
			</section>

			<!-- SHARE -->
			<section id="share" class="band">
				<div class="wrap">
					<header class="band-head" data-reveal>
						<h2 data-i18n="share.title">{t('share.title')}</h2>
						<p class="lead" data-i18n="share.sub">{t('share.sub')}</p>
					</header>
					<div class="share-grid">
						<div class="share-cards" data-reveal>
							<figure class="scard scard-map">
								<div class="scard-map-bg">
									<svg viewBox="0 0 240 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
										<g class="scard-contours">
											<path d="M-20 80 C 60 40 140 120 260 70"></path>
											<path d="M-20 150 C 60 110 140 190 260 140"></path>
											<path d="M-20 230 C 60 190 140 270 260 220"></path>
										</g>
										<path d="M40 280 C 70 250 60 180 110 168 C 160 156 150 100 200 70" fill="none" stroke="#4ce08c" stroke-width="4" stroke-linecap="round"></path>
										<circle cx="40" cy="280" r="6" fill="#eef1ee"></circle>
										<circle cx="200" cy="70" r="6" fill="none" stroke="#4ce08c" stroke-width="3"></circle>
									</svg>
								</div>
								<figcaption>
									<span class="cap" data-i18n="share.card.route">{t('share.card.route')}</span>
									<div class="scard-row"><b class="mono">7.42 km</b><b class="mono">5'18"/km</b></div>
								</figcaption>
							</figure>
							<figure class="scard scard-photo">
								<div class="scard-photo-bg"></div>
								<figcaption class="scard-photo-cap">
									<b class="mono">42:18</b>
									<span class="cap">MOV · 12 MAY</span>
								</figcaption>
							</figure>
						</div>

						<ul class="share-feats" data-reveal>
							<li><svg class="ico-sm" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"></rect><circle cx="8.5" cy="10" r="1.6" fill="currentColor"></circle><path d="M4 17l5-4 4 3 3-2 4 3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg><span data-i18n="share.f1">{t('share.f1')}</span></li>
							<li><svg class="ico-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8l9-4 9 4-9 4-9-4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M3 8v8l9 4 9-4V8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg><span data-i18n="share.f2">{t('share.f2')}</span></li>
