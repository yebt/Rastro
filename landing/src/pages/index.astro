				padding: var(--sp-5);
				box-shadow: var(--shadow);
				display: flex;
				flex-direction: column;
				gap: var(--sp-5);
			}
			.panel-block { display: flex; flex-direction: column; gap: var(--sp-3); }
			.panel-block + .panel-block { padding-top: var(--sp-5); border-top: 1px solid var(--line); }
			.panel-cap { display: flex; align-items: center; justify-content: space-between; }
			.medal { width: 22px; height: 22px; }
			.accent { color: var(--accent); }
			.insights { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
			.insights li { position: relative; padding-left: 18px; font-size: 15px; color: var(--ink); }
			.insights li::before { content: ''; position: absolute; left: 2px; top: 8px; width: 6px; height: 6px; border-radius: 999px; background: var(--accent); }
			.splits { display: grid; grid-template-columns: repeat(7, 1fr); gap: 7px; align-items: end; height: 116px; }
			.splits span {
				position: relative;
				height: var(--h);
