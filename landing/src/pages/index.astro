			.mode h3 { font-size: 24px; text-transform: uppercase; }
			.mode p { color: var(--muted); font-size: 15px; }

			/* Analysis */
			.analysis { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(28px, 5vw, 68px); align-items: center; }
			.statcluster {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				margin-top: var(--sp-6);
				background: var(--line);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				overflow: hidden;
			}
			.stat { background: color-mix(in srgb, var(--surface) 82%, var(--bg)); padding: var(--sp-4); display: flex; flex-direction: column; }
			.stat b { font-size: clamp(19px, 2.8vw, 25px); font-weight: 700; line-height: 1.05; }
