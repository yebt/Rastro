			.curve { width: 100%; height: 90px; }
			.panel-note { font-size: 13.5px; color: var(--muted); }

			/* Share */
			.share-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(28px, 5vw, 64px); align-items: center; }
			.share-cards { display: flex; gap: var(--sp-4); justify-content: center; }
			.scard {
				margin: 0;
				width: 200px;
				aspect-ratio: 3 / 4;
				border-radius: var(--radius-lg);
				overflow: hidden;
				border: 1px solid var(--line-2);
				box-shadow: var(--shadow-lg);
				position: relative;
			}
			.scard-map { background: linear-gradient(180deg, #10201a 0%, #0a0c0d 100%); }
			.scard-map-bg { position: absolute; inset: 0; }
			.scard-map-bg svg { width: 100%; height: 100%; }
			.scard-contours path { fill: none; stroke: color-mix(in srgb, var(--accent) 22%, transparent); stroke-width: 1; }
			.scard figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--sp-4); background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), transparent); }
			.scard-row { display: flex; justify-content: space-between; margin-top: 6px; font-size: 13px; color: var(--ink); }
			.scard-photo { transform: rotate(4deg) translateY(8px); }
			.scard-photo-bg {
				position: absolute; inset: 0;
				background:
					radial-gradient(80% 60% at 30% 20%, #3a2a1e, transparent 60%),
					linear-gradient(150deg, #52381f 0%, #241a12 60%, #0a0c0d 100%);
			}
			.scard-photo-bg::after {
				content: ''; position: absolute; inset: 0;
				background: linear-gradient(0deg, rgba(0,0,0,0.55), rgba(0,0,0,0.15));
			}
			.scard-photo-cap { display: flex; flex-direction: column; gap: 2px; }
			.scard-photo-cap b { font-size: 26px; color: #fff; }
			.share-feats { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-4); }
			.share-feats li { display: flex; align-items: center; gap: var(--sp-3); font-size: 16.5px; }
			.ico-sm { width: 26px; height: 26px; color: var(--ink); flex: none; }

			/* Privacy */
			.privacy { display: grid; grid-template-columns: 1fr 0.8fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
			.pledge { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--sp-4); }
			.pledge li {
				display: flex; gap: var(--sp-4); align-items: flex-start;
				background: color-mix(in srgb, var(--surface) 80%, transparent);
				border: 1px solid var(--line);
				border-radius: var(--radius);
				padding: var(--sp-4) var(--sp-5);
			}
			.pledge li div { display: flex; flex-direction: column; }
			.pledge b { font-family: var(--font-display); font-size: 21px; text-transform: uppercase; }
			.pledge span { color: var(--muted); font-size: 14.5px; }

			/* Exercises */
			.exercise { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 5vw, 68px); align-items: center; }
			.exercise-panel {
				background: linear-gradient(180deg, var(--surface) 0%, var(--bg-2) 100%);
				border: 1px solid var(--line-2);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow);
				overflow: hidden;
			}
			.repcard { padding: var(--sp-5); border-bottom: 1px solid var(--line); }
			.repcount { display: flex; align-items: baseline; gap: var(--sp-3); margin: var(--sp-3) 0; }
			.repcount b { font-family: var(--font-mono); font-size: clamp(44px, 8vw, 62px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; }
			.repname { font-family: var(--font-display); font-size: 24px; text-transform: uppercase; }
			.repdots { display: grid; grid-template-columns: repeat(12, 1fr); gap: 6px; margin-bottom: var(--sp-3); }
			.repdots span { height: 8px; border-radius: 999px; background: var(--accent); }
			.routine { padding: var(--sp-5); }
			.steps { list-style: none; margin: var(--sp-3) 0 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
			.step { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-3); border-radius: var(--radius); font-size: 15.5px; }
			.step i { margin-left: auto; font-size: 13px; color: var(--muted); font-style: normal; }
			.step-ico { width: 20px; height: 20px; color: var(--muted); flex: none; }
			.step-node { width: 12px; height: 12px; border-radius: 999px; border: 2px solid var(--accent); flex: none; margin: 0 4px; }
			.step-node.dim { border-color: var(--line-2); }
			.step.done { color: var(--muted); }
			.step.done span { text-decoration: line-through; text-decoration-color: var(--line-2); }
			.step.now { background: color-mix(in srgb, var(--accent) 12%, transparent); font-weight: 500; }
			.step.now .step-node { background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
			.step.rest { color: var(--muted); }
			.step.rest i { color: var(--accent); }

			/* Roadmap — a GPS track of what's next */
			.roadmap { list-style: none; margin: 0; padding: 0; position: relative; max-width: 760px; }
			.roadmap::before { content: ''; position: absolute; left: 7px; top: 14px; bottom: 14px; width: 2px; background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 18%, transparent)); }
			.road-item { position: relative; display: flex; padding: var(--sp-5) 0 var(--sp-5) var(--sp-6); }
			.road-item + .road-item { border-top: 1px solid var(--line); }
			.road-node { position: absolute; left: 0; top: calc(var(--sp-5) + 4px); width: 16px; height: 16px; border-radius: 999px; background: var(--bg); border: 2px solid var(--accent); }
			.road-node.end { background: var(--accent); }
			.road-top { display: flex; align-items: center; gap: var(--sp-3); flex-wrap: wrap; }
			.road-top b { font-family: var(--font-display); font-size: 22px; text-transform: uppercase; }
			.road-tag { color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); border-radius: 999px; padding: 3px 9px; }
			.road-body p { color: var(--muted); font-size: 15px; margin-top: 5px; max-width: 60ch; }

			/* Closer */
			.closer { padding: clamp(64px, 11vw, 148px) 0; text-align: center; }
			.closer-in { max-width: 40ch; margin-inline: auto; display: flex; flex-direction: column; align-items: center; }
			.closer-glyph { margin-bottom: var(--sp-4); }
			.closer h2 { font-size: clamp(40px, 7vw, 76px); text-transform: uppercase; }
			.closer .lead { margin-inline: auto; }
			.closer .hero-cta { margin-top: var(--sp-6); }
			.dl-req { margin-top: var(--sp-5); }

			/* Footer */
			.foot { border-top: 1px solid var(--line); padding: var(--sp-7) 0; background: var(--bg-2); }
			.foot-in { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; }
			.foot-brand { display: flex; align-items: center; gap: var(--sp-3); }
			.foot-brand div { display: flex; flex-direction: column; }
			.foot-brand b { font-family: var(--font-display); font-size: 18px; }
			.foot-tag { font-size: 12.5px; color: var(--faint); }
			.foot-links { display: flex; gap: var(--sp-5); margin-left: auto; font-size: 14px; color: var(--muted); flex-wrap: wrap; }
			.foot-links a { transition: color 0.15s ease; }
			.foot-links a:hover { color: var(--ink); }
			.foot-made { flex-basis: 100%; }

			/* ---------- Reveal (progressive: hidden only when JS is present) ---------- */
			.js [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1); }
			.js [data-reveal].in { opacity: 1; transform: none; }
			@media (prefers-reduced-motion: reduce) {
				.js [data-reveal] { opacity: 1; transform: none; transition: none; }
				.route-line { stroke-dashoffset: 0 !important; animation: none !important; }
			}

			/* ---------- Responsive ---------- */
			@media (max-width: 1040px) {
				.hero-in { grid-template-columns: 1fr; }
				.hero-instrument { order: -1; }
			}
			@media (max-width: 900px) {
				.analysis, .share-grid, .privacy, .exercise { grid-template-columns: 1fr; }
				.analysis-copy, .exercise-copy { order: -1; }
				.nav-links { display: none; }
			}
			@media (max-width: 680px) {
				.modes { grid-template-columns: 1fr; }
				.mode + .mode { border-left: none; border-top: 1px solid var(--line); }
			}
			@media (max-width: 620px) {
				.statcluster { grid-template-columns: repeat(2, 1fr); }
				.share-cards { gap: var(--sp-2); }
				.scard { width: 168px; }
				.hud-cell b { font-size: 18px; }
			}
		</style>
	</body>
</html>
